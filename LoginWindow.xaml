<Window x:Class="MedScribeOS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in · MedScribeAI"
        Icon="/Assets/appicon.ico"
        Height="470" Width="400"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=EmailBox}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🩺 MedScribeAI"
                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="Horizon Family Medical Group — sign in to continue"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="EMAIL" Style="{StaticResource LabelStyle}" Margin="0,28,0,6"/>
        <TextBox Grid.Row="3" x:Name="EmailBox" Height="36" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Text="PASSWORD" Style="{StaticResource LabelStyle}" Margin="0,16,0,6"/>
        <PasswordBox Grid.Row="5" x:Name="PasswordBox" Height="36" VerticalContentAlignment="Center"
                     Background="{StaticResource BgCard2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="8"
                     CaretBrush="{StaticResource TextPrimaryBrush}"/>

        <TextBlock Grid.Row="6" x:Name="ErrorText"
                   Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" FontSize="12"
                   Margin="0,14,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" VerticalAlignment="Bottom">
            <Button x:Name="SignInButton" Content="Sign In" Style="{StaticResource PrimaryButtonStyle}"
                    Height="40" IsDefault="True" Click="SignInButton_Click"/>
            <TextBlock x:Name="StatusText" Text=""
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
