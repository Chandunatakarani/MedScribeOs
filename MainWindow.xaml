<Window x:Class="MedScribeOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:MedScribeOS.Services"
        Icon="/Assets/appicon.ico"
        Title="MedScribeAI" Height="760" Width="920"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <svc:SpeakerToAlignmentConverter x:Key="SpeakerAlign"/>
        <svc:SpeakerToBubbleBrushConverter x:Key="SpeakerBubble"/>
        <svc:SpeakerToForegroundConverter x:Key="SpeakerFg"/>
        <svc:SpeakerToCornerConverter x:Key="SpeakerCorner"/>
        <svc:SpeakerToHeaderConverter x:Key="SpeakerHeader"/>

        <!-- One bubble template for both sides; the converters above key every
             per-speaker difference (side, colour, corner, header) off Speaker. -->
        <DataTemplate x:Key="ChatBubbleTemplate">
            <Grid Margin="0,5,0,5" HorizontalAlignment="{Binding Converter={StaticResource SpeakerAlign}}">
                <Border MaxWidth="580" Padding="14,10"
                        Background="{Binding Converter={StaticResource SpeakerBubble}}"
                        CornerRadius="{Binding Converter={StaticResource SpeakerCorner}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Converter={StaticResource SpeakerHeader}}"
                                       FontSize="11.5" FontWeight="Bold" Opacity="0.85"
                                       Foreground="{Binding Converter={StaticResource SpeakerFg}}"/>
                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                       Margin="7,0,0,0" FontSize="11.5" Opacity="0.65"
                                       Foreground="{Binding Converter={StaticResource SpeakerFg}}"/>
                            <Button Content="⇄" Click="FlipSpeaker_Click" ToolTip="Wrong speaker? Click to flip Doctor / Patient"
                                    Margin="8,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                    Cursor="Hand" FontSize="12" Opacity="0.75"
                                    Foreground="{Binding Converter={StaticResource SpeakerFg}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14.5" LineHeight="20"
                                   Foreground="{Binding Converter={StaticResource SpeakerFg}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="22,16" Background="{StaticResource NavBarBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🩺 MedScribeAI" Foreground="{StaticResource TextPrimaryBrush}" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="  ·  Horizon Family Medical Group" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentUser" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BtnTemplates" Content="📋 Templates" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="BtnTemplates_Click"/>
                    <Button x:Name="BtnSignOut" Content="Sign out" Style="{StaticResource GhostButtonStyle}" Click="BtnSignOut_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tab strip -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8">
            <RadioButton x:Name="TabVoiceAnalyzer" Content="🗣 Voice Analyzer" Style="{StaticResource TabButtonStyle}" Checked="TabVoiceAnalyzer_Checked" GroupName="Tabs"/>
            <RadioButton x:Name="TabVoiceDictation" Content="🎙 Voice Dictation" Style="{StaticResource TabButtonStyle}" Checked="TabVoiceDictation_Checked" GroupName="Tabs"/>
            <RadioButton x:Name="TabFileAnalyzer" Content="📁 File Analyzer" Style="{StaticResource TabButtonStyle}" Checked="TabFileAnalyzer_Checked" GroupName="Tabs"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="2" Margin="16">

            <!-- ===================== VOICE ANALYZER ===================== -->
            <Grid x:Name="PanelVoiceAnalyzer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnStartConvo" Content="● Start Conversation" Style="{StaticResource PrimaryButtonStyle}" Click="BtnStartConvo_Click"/>
                            <Button x:Name="BtnEndConvo" Content="⏹ End Conversation" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0" IsEnabled="False" Click="BtnEndConvo_Click"/>
                            <TextBlock x:Name="TxtConvoStatus" Text="Not recording" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <ProgressBar x:Name="MicLevelBar" Width="80" Height="6" Minimum="0" Maximum="1" Value="0"
                                         Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0"
                                         Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnEnrollVoice" Content="🎙️ Enroll Doctor Voice" Style="{StaticResource GhostButtonStyle}" Click="BtnEnrollVoice_Click"/>
                            <TextBlock x:Name="TxtEnrollStatus" Text="Required once so Doctor/Patient turns can be told apart by voice, not guesswork." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Template:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TemplatePicker" Width="240" DisplayMemberPath="Name" SelectionChanged="TemplatePicker_SelectionChanged"/>
                            <Button x:Name="BtnManageTemplates" Content="Manage…" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" Click="BtnTemplates_Click"/>
                            <TextBlock x:Name="TxtTemplateHint" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" x:Name="PanelAnalyzeAction" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Review the conversation below - correct any misheard words or swapped speakers - then:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Width="480"/>
                        <Button x:Name="BtnAnalyze" Content="🤖 Analyze → HPI / ROS" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" Click="BtnAnalyze_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <!-- Live two-sided chat: doctor bubbles right, patient bubbles left,
                             appended turn-by-turn as each is transcribed, auto-scrolled to newest. -->
                        <ListBox x:Name="ChatList"
                                 ItemsSource="{Binding ChatTurns, RelativeSource={RelativeSource AncestorType=Window}}"
                                 ItemTemplate="{StaticResource ChatBubbleTemplate}"
                                 ItemContainerStyle="{StaticResource ChatItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="TxtChatEmpty"
                                   Text="Press Start Conversation to begin. Turns appear here live as a two-sided chat — nothing is charted automatically."
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" FontStyle="Italic"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" x:Name="PanelHpiRos" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Visibility="Collapsed" MaxHeight="340">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtReviewHeader" Text="⚕️ Doctor Review — all fields editable before injecting" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                            <!-- Section panels + per-section inject buttons are generated at runtime from the active template. -->
                            <StackPanel x:Name="TemplateResultPanel"/>
                            <TextBlock x:Name="TxtInjectStatus" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================== VOICE DICTATION ===================== -->
            <Grid x:Name="PanelVoiceDictation" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="110" Height="110" Cursor="Hand" MouseLeftButtonUp="MicCircle_Click">
                        <Ellipse x:Name="MicCircle" Fill="{StaticResource BorderBrush2}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#007AFF" BlurRadius="28" ShadowDepth="0" Opacity="0.22"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="🎙" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock x:Name="TxtMicStatus" Text="OFF — click to enable dictation" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="When ON, click into any eCW field, then speak. Each phrase transcribes and fills automatically after a few seconds." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,24,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" Width="420" TextAlignment="Center" FontSize="12"/>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,24,0,0" Width="420">
                        <StackPanel>
                            <TextBlock Text="LAST PHRASE" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="TxtLastPhrase" Text="—" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===================== FILE ANALYZER (placeholder) ===================== -->
            <Grid x:Name="PanelFileAnalyzer" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="File Analyzer — coming next" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Same Whisper + GPT-4o pipeline as Voice Analyzer, applied to uploaded documents and audio files. Wiring this once the first two tabs are confirmed working end-to-end." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Width="380" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Floating toast stack - shows every Notify.* call, spans the whole window -->
        <svc:ToastHost x:Name="Toasts" Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
</Window>
